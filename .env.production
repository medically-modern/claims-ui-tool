# Loaded automatically by `vite build` (production mode). These are PUBLIC
# values — they ship in the client bundle either way — so they live here, not
# in Actions secrets. Roll back by blanking a value + rebuild.

# Josh's monday-gateway on Railway: the only thing that holds RingCentral
# credentials. The Comms sheet (Subscription tab → Actions → Comms) reads the
# patient's texts and call log through it. Same origin allow-list as the
# Command Center (https://medically-modern.github.io), so no gateway change was
# needed. Blank = Comms sheet shows "not configured"; the rest of the app is
# untouched.
VITE_COMMS_GATEWAY_URL=https://monday-gateway-production.up.railway.app

# Google Workspace sign-in for the text thread (the gateway's
# /messaging/conversation route is token-gated). Same OAuth client + domain as
# the Command Center; the origin is already authorised on it. Only the Comms
# sheet asks for sign-in — nothing else in the app is gated.
VITE_GOOGLE_CLIENT_ID=179163584309-omjj4uru4aop9190sr00mcmrvjqembip.apps.googleusercontent.com
VITE_AUTH_DOMAIN=medicallymodern.com
